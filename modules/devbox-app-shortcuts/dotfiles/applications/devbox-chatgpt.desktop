[Desktop Entry]
Type=Application
Name=ChatGPT
Comment=Focus or launch ChatGPT as a Chromium web app
Exec=/home/dylan/.local/bin/devbox-focus-or-launch --class chrome-chatgpt.com__-Default -- chromium --ozone-platform-hint=auto --app=https://chatgpt.com/

#!/usr/bin/env bash
# Keep the devbox DP/MST displays arranged without persisting KWin output UUIDs.
# With two connected displays, the wider one is the left display and the other
# is placed immediately to its right.  A topology is attempted only once to
# avoid hammering KWin while an MST link is negotiating.

set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_RUNTIME_DIR="$runtime_dir"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${runtime_dir}/bus}"

last_topology=""

apply_layout() {
  local state connected left_id right_id left_width topology
  state="$(kscreen-doctor -j 2>/dev/null)" || return 0
  connected="$(jq '[.outputs[] | select(.connected)] | length' <<<"$state")"

  # Nothing to arrange until the Dell MST downstream display has enumerated.
  (( connected >= 2 )) || return 0

  # This is deliberately model-agnostic.  The ultrawide (3440px) becomes the
  # left display; the Dell becomes the right display.  Do not use KWin UUIDs:
  # they change when the MST branch is unplugged or re-detected.
  left_id="$(jq -r '[.outputs[] | select(.connected) | {id, width: .size.width}] | max_by(.width).id' <<<"$state")"
  left_width="$(jq -r --argjson id "$left_id" '.outputs[] | select(.id == $id) | .size.width' <<<"$state")"
  right_id="$(jq -r --argjson id "$left_id" '.outputs[] | select(.connected and .id != $id) | .id' <<<"$state" | head -n1)"
  [[ "$left_id" != "null" && "$right_id" != "null" && "$left_width" =~ ^[0-9]+$ ]] || return 0

  topology="${left_id}:${left_width}:${right_id}"
  [[ "$topology" == "$last_topology" ]] && return 0
  last_topology="$topology"

  echo "[devbox-display] applying left output ${left_id} and right output ${right_id}"
  kscreen-doctor \
    "output.${left_id}.enable" \
    "output.${right_id}.enable" \
    "output.${left_id}.position.0,0" \
    "output.${right_id}.position.${left_width},0" || \
    echo "[devbox-display] KDE rejected this MST topology; waiting for the next link change" >&2
}

while true; do
  apply_layout
  sleep 5
done

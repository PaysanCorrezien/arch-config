#!/usr/bin/env bash
set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}"
data_file="$runtime_dir/devbox-keyboard-shortcuts.json"
temporary_file="$data_file.tmp.$$"
trap 'rm -f "$temporary_file"' EXIT

python3 "$HOME/.local/lib/devbox/devbox-keyboard-shortcuts-data.py" > "$temporary_file"
chmod 0600 "$temporary_file"
mv -f "$temporary_file" "$data_file"
trap - EXIT

# The global shortcut is a toggle: close the existing viewer when it is
# running, otherwise start one instance. --no-duplicate covers presses that
# race while Quickshell is registering its IPC endpoint.
if qs ipc -c devbox-keyboard-helper call keyboard-shortcuts close >/dev/null 2>&1; then
  exit 0
fi

exec qs --no-duplicate --config devbox-keyboard-helper

#!/bin/bash
# Bound Hermes startup on DNS readiness. Network-online can be reached before
# the desktop resolver is usable, especially during Tailscale/NM convergence.
set -u

attempt=0
while (( attempt < 30 )); do
    if getent ahosts discord.com >/dev/null 2>&1 \
        && getent ahosts api.github.com >/dev/null 2>&1 \
        && getent ahosts artificialanalysis.ai >/dev/null 2>&1; then
        exit 0
    fi
    attempt=$((attempt + 1))
    sleep 2
done

echo "Hermes startup blocked: required Discord, GitHub, or Artificial Analysis DNS was unavailable for 60 seconds" >&2
exit 75

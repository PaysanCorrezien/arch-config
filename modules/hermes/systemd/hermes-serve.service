[Unit]
Description=Hermes Agent Remote Dashboard API
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main serve --host 0.0.0.0 --port 9119 --skip-build
WorkingDirectory=%h/.hermes
Environment="PATH=%h/.hermes/hermes-agent/venv/bin:%h/.local/bin:/usr/bin:/usr/local/bin"
Environment="VIRTUAL_ENV=%h/.hermes/hermes-agent/venv"
Environment="HERMES_HOME=%h/.hermes"
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=default.target

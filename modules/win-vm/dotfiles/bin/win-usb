#!/usr/bin/env bash
# win-usb — hot-plug USB devices between the Arch host and the Windows guest.
#
# This is the real audio path. RDP's /sound and /microphone redirection is
# resampled and buffered; handing Windows the actual device is not. A Bluetooth
# headset cannot be passed directly — it is not a USB device. Pass the HOST'S
# BLUETOOTH RADIO instead, and Windows pairs the headset itself, owning HFP/A2DP.
#
#   win-usb list                    devices on the host, marked if attached
#   win-usb attach 1234:abcd        hand a device to the guest
#   win-usb detach 1234:abcd        take it back
#   win-usb audio                   attach everything in WIN_VM_USB at once
#
# NOTE: while the Bluetooth radio is attached to the guest, the HOST has no
# Bluetooth. That is inherent — a radio has one owner. A second USB BT dongle
# (~10 EUR) is the clean fix if you want headsets on both sides.

set -euo pipefail

ENV_FILE="${HOME}/.config/win-vm/win-vm.env"
# shellcheck source=/dev/null
[[ -f "${ENV_FILE}" ]] && source "${ENV_FILE}"
: "${VM_NAME:=windows}"
: "${WIN_VM_USB:=}"

VIRSH=(virsh -c qemu:///system)

say()  { printf '\033[1;34m[win-usb]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[win-usb]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[win-usb]\033[0m %s\n' "$*" >&2; exit 1; }

require_running() {
  local s; s="$("${VIRSH[@]}" domstate "${VM_NAME}" 2>/dev/null | head -n1 | tr -d '[:space:]')"
  [[ "${s}" == "running" ]] || die "Guest '${VM_NAME}' is not running (state: ${s:-undefined})."
}

devxml() {
  local id="$1"
  [[ "${id}" == *:* ]] || die "Expected vendor:product (e.g. 413c:c034), got '${id}'"
  printf "<hostdev mode='subsystem' type='usb' managed='yes'><source><vendor id='0x%s'/><product id='0x%s'/></source></hostdev>" \
    "${id%%:*}" "${id##*:}"
}

attached_ids() {
  "${VIRSH[@]}" dumpxml "${VM_NAME}" 2>/dev/null \
    | grep -oP "vendor id='0x\K[0-9a-fA-F]{4}(?=')|product id='0x\K[0-9a-fA-F]{4}(?=')" \
    | paste -d: - - 2>/dev/null || true
}

case "${1:-list}" in
  list)
    mapfile -t ATTACHED < <(attached_ids)
    say "USB devices on the host:"
    while read -r line; do
      id="$(sed -nE 's/.*ID ([0-9a-f]{4}:[0-9a-f]{4}).*/\1/p' <<< "$line")"
      mark="   "
      for a in "${ATTACHED[@]:-}"; do [[ "${a,,}" == "${id,,}" ]] && mark=" ->"; done
      printf '%s %s\n' "${mark}" "${line}"
    done < <(lsusb)
    echo
    say "'->' marks devices currently handed to '${VM_NAME}'."
    say "Configured for winbox session handoff (WIN_VM_USB): ${WIN_VM_USB:-<none>}"
    ;;

  attach)
    [[ -n "${2:-}" ]] || die "usage: win-usb attach <vendor:product>"
    require_running
    lsusb -d "$2" >/dev/null 2>&1 || die "Device $2 is not plugged into the host."
    "${VIRSH[@]}" attach-device "${VM_NAME}" /dev/stdin <<< "$(devxml "$2")"
    say "Attached $2 to ${VM_NAME}."
    ;;

  detach)
    [[ -n "${2:-}" ]] || die "usage: win-usb detach <vendor:product>"
    require_running
    "${VIRSH[@]}" detach-device "${VM_NAME}" /dev/stdin <<< "$(devxml "$2")"
    say "Detached $2 — back on the host."
    ;;

  audio)
    [[ -n "${WIN_VM_USB}" ]] || die "WIN_VM_USB is empty in ${ENV_FILE}. Run 'win-usb list' and fill it in."
    require_running
    for id in ${WIN_VM_USB}; do
      if lsusb -d "${id}" >/dev/null 2>&1; then
        "${VIRSH[@]}" attach-device "${VM_NAME}" /dev/stdin <<< "$(devxml "${id}")" \
          && say "  attached ${id}" || warn "  failed ${id} (already attached?)"
      else
        warn "  ${id} not plugged in — skipped"
      fi
    done
    ;;

  -h|--help|help)
    sed -n '2,18p' "$0" | sed 's/^# \?//'
    ;;

  *)
    die "Unknown subcommand '$1'. Try --help."
    ;;
esac

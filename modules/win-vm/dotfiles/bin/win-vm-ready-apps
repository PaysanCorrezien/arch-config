#!/usr/bin/env bash
# Start the host-side tools that should be ready whenever the Windows VM boots.

set -euo pipefail

BRASSENS_REPO="/home/dylan/code/brassens-monorepo"

warn() { printf '\033[1;33m[win-vm-ready-apps]\033[0m %s\n' "$*" >&2; }

if [[ ! -d "${BRASSENS_REPO}" ]]; then
  warn "Brassens repository not found: ${BRASSENS_REPO}"
else
  # A transient user unit makes the terminal independent of winbox and also
  # prevents a second Remote Control terminal while the first remains open.
  if ! systemctl --user is-active --quiet win-vm-claude-remote-control.service; then
    systemd-run --user --quiet --collect \
      --unit=win-vm-claude-remote-control.service \
      /usr/bin/ghostty --working-directory="${BRASSENS_REPO}" \
      -e /usr/bin/claude --remote-control brassens \
      || warn "Claude Remote Control did not launch."
  fi
fi

# codex-desktop is single-instance, so this opens it when absent and reuses the
# existing desktop process when it is already running.
if ! pgrep -u "${UID}" -f '^/usr/bin/codex-desktop( |$)' >/dev/null 2>&1; then
  systemd-run --user --quiet --collect \
    --unit=win-vm-chatgpt-desktop.service \
    /usr/bin/codex-desktop \
    || warn "ChatGPT Desktop did not launch."
fi

#!/usr/bin/env bash
# winbox — bring up the Windows guest and drop into it fullscreen, both monitors.
#
# This is the daily-driver entry point. Bind it to a KDE global shortcut
# (System Settings -> Shortcuts -> Custom -> `winbox`) and it becomes the
# "switch to Windows" key.
#
#   winbox              start if needed, connect fullscreen multi-monitor
#   winbox --window     connect windowed (useful for a quick glance)
#   winbox --console    open the SPICE/qxl console instead (install / recovery)
#   winbox --stop       graceful shutdown via the guest agent
#   winbox --status     domain state, address, RDP reachability
#
# Requires: freerdp (v3), libvirt. Config: ~/.config/win-vm/win-vm.env

set -euo pipefail

ENV_FILE="${HOME}/.config/win-vm/win-vm.env"
# shellcheck source=/dev/null
[[ -f "${ENV_FILE}" ]] && source "${ENV_FILE}"

: "${VM_NAME:=windows}"
: "${VM_IP:=192.168.122.50}"
: "${WIN_SHARE_DIR:=/srv/winshare}"
: "${RDP_USER:=${USER}}"
: "${RDP_DOMAIN:=}"
# 0x040C = French (AZERTY). Mismatched layout is the classic first-hour
# papercut — every symbol key lands somewhere else. Override here if needed.
: "${RDP_KBD:=0x0000040C}"

say()  { printf '\033[1;34m[winbox]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[winbox]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[winbox]\033[0m %s\n' "$*" >&2; exit 1; }

# FreeRDP 3 renamed the binaries. Accept either, prefer the X/Wayland client.
FREERDP=""
for c in xfreerdp3 xfreerdp sdl-freerdp3 sdl-freerdp; do
  command -v "$c" >/dev/null 2>&1 && { FREERDP="$c"; break; }
done
[[ -n "${FREERDP}" ]] || die "No FreeRDP client found. Install the 'freerdp' package."

domstate() { virsh -c qemu:///system domstate "${VM_NAME}" 2>/dev/null | head -n1 | tr -d '[:space:]'; }

ensure_running() {
  local state; state="$(domstate)"
  case "${state}" in
    running)  ;;
    paused)   say "Guest is paused — resuming"; virsh -c qemu:///system resume "${VM_NAME}" >/dev/null ;;
    "shutoff"|"shutdown"|"")
      [[ -n "${state}" ]] || die "Domain '${VM_NAME}' is not defined. Run the win-vm module hook first."
      say "Starting '${VM_NAME}'..."
      virsh -c qemu:///system start "${VM_NAME}" >/dev/null
      ;;
    *) warn "Unexpected domain state '${state}' — trying anyway" ;;
  esac
}

wait_for_rdp() {
  local deadline=$(( SECONDS + 180 ))
  say "Waiting for RDP on ${VM_IP}:3389 ..."
  while (( SECONDS < deadline )); do
    if timeout 1 bash -c ">/dev/tcp/${VM_IP}/3389" 2>/dev/null; then
      say "  up after $(( SECONDS ))s"
      return 0
    fi
    sleep 2
  done
  die "RDP never came up on ${VM_IP}:3389.
     Check from the console:  winbox --console
     Common causes: guest is Windows Home (no RDP server), Remote Desktop not
     enabled, Windows Firewall blocking, or the guest took a different address
     (virsh -c qemu:///system domifaddr ${VM_NAME})."
}

connect() {
  local mode="$1"
  local status=0
  local -a args=(
    "/v:${VM_IP}"
    "/u:${RDP_USER}"
    "/cert:tofu"

    # --- Display -----------------------------------------------------------
    # /multimon spans every host monitor and presents each as a real display
    # to Windows, with correct geometry. Do NOT add +dynamic-resolution: it is
    # a single-monitor feature and fights /multimon.
    "/gfx:avc444"
    "/network:lan"
    "/video"

    # --- Input -------------------------------------------------------------
    "/kbd:layout:${RDP_KBD}"

    # --- Integration -------------------------------------------------------
    "/clipboard"
    "/drive:winshare,${WIN_SHARE_DIR}"
    "+home-drive"

    # --- Audio (FALLBACK ONLY) ---------------------------------------------
    # These route audio over the RDP transport, which is resampled and
    # buffered. Fine for system sounds. For real capture work, pass the USB
    # audio device (or the Bluetooth radio) straight through: `win-usb attach`.
    "/sound:sys:pulse"
    "/microphone:sys:pulse"

    # --- Session behaviour -------------------------------------------------
    "+auto-reconnect"
    "/auto-reconnect-max-retries:20"
    "-grab-keyboard"
  )

  if [[ "${mode}" == "fullscreen" ]]; then
    args+=( "/multimon" "/f" "/floatbar:sticky:off,default:hidden" )
  else
    args+=( "/size:1600x900" "/dynamic-resolution" )
  fi

  # Give Windows the real selected USB audio device(s) while this desktop is
  # foregrounded, then return them to Linux as soon as the RDP session exits.
  if [[ -n "${WIN_VM_USB:-}" ]]; then
    say "Handing USB audio devices to Windows..."
    "${HOME}/.local/bin/win-usb" audio || warn "Some USB devices could not be attached."
  fi

  say "Connecting (${mode}) via ${FREERDP}"
  # FreeRDP is chatty on stderr about certs and codecs; keep it out of the way
  # unless something actually fails.
  "${FREERDP}" "${args[@]}" || status=$?
  if [[ -n "${WIN_VM_USB:-}" ]]; then
    say "Returning USB audio devices to Linux..."
    for id in ${WIN_VM_USB}; do
      "${HOME}/.local/bin/win-usb" detach "${id}" || true
    done
  fi
  return "${status}"
}

case "${1:-}" in
  --status)
    printf 'domain : %s\n' "$(domstate || echo 'not defined')"
    printf 'address: %s\n' "${VM_IP}"
    if timeout 1 bash -c ">/dev/tcp/${VM_IP}/3389" 2>/dev/null; then
      printf 'rdp    : reachable\n'
    else
      printf 'rdp    : NOT reachable\n'
    fi
    printf 'share  : %s\n' "${WIN_SHARE_DIR}"
    virsh -c qemu:///system domifaddr "${VM_NAME}" 2>/dev/null || true
    ;;
  --stop)
    say "Requesting graceful shutdown (needs qemu-guest-agent in the guest)"
    virsh -c qemu:///system shutdown "${VM_NAME}"
    ;;
  --console)
    ensure_running
    say "Opening SPICE console (install / recovery path)"
    exec virt-viewer -c qemu:///system "${VM_NAME}"
    ;;
  --window)
    ensure_running; wait_for_rdp; connect windowed
    ;;
  ""|--fullscreen)
    ensure_running; wait_for_rdp; connect fullscreen
    ;;
  -h|--help)
    sed -n '2,16p' "$0" | sed 's/^# \?//'
    ;;
  *)
    die "Unknown option '$1'. Try --help."
    ;;
esac

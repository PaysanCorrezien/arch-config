# devbox Windows VM profile.  This file contains no password or private key.
# Credentials live only in ~/.config/win-vm/windows-password (mode 0600).

VM_NAME="windows"
VM_MEM_GIB=32
HOST_RESERVED_CORES=2
VM_DISK_PATH="/var/lib/libvirt/images/windows.raw"
VM_DISK_SIZE="500G"
VM_MAC="52:54:00:be:ef:11"
VM_IP="192.168.122.50"
WIN_SHARE_DIR="/srv/winshare"

# Dell P2724DEB USB device: attached to Windows only for an active winbox
# session, then released back to Linux when returning to the host desktop.
WIN_VM_USB="413c:c034"

# devbox Windows VM profile.  This file contains no password or private key.
# Credentials live only in ~/.config/win-vm/windows-password (mode 0600).

VM_NAME="windows"
VM_MEM_GIB=32
HOST_RESERVED_CORES=2
VM_DISK_PATH="/var/lib/libvirt/images/windows.raw"
VM_DISK_SIZE="500G"
VM_MAC="52:54:00:be:ef:11"
VM_IP="192.168.122.50"
WIN_SHARE_DIR="/srv/winshare"

# Peripherals that follow the fullscreen Windows session. Each device is
# detached from Linux when winbox opens, passed to Windows as a real USB device,
# then returned to Linux when the RDP session closes.
#
# Dell P2724DEB USB device; YubiKey 4/5 (OTP, U2F and smart-card modes).
WIN_VM_USB="413c:c034 1050:0407"

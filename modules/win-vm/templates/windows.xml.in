<!--
  Windows 11 guest for the `devbox` host.

  Generated from templates/windows.xml.in by scripts/setup-win-vm.sh.
  Do NOT edit the installed copy by hand — edit the template and re-run the
  hook, or the next `dcli sync` will quietly stomp your changes.

  Placeholders substituted by the setup script:
    @NAME@ @UUID@ @MEM_KIB@ @VCPUS@ @CORES@ @THREADS@ @CPUTUNE@
    @DISK_PATH@ @INSTALLER_USB_IMAGE@ @MAC@ @UID@ @SHARE_DIR@ @HOSTDEV@

  Design notes that are easy to break:
    * memoryBacking uses memfd + access mode='shared'. virtiofs REQUIRES shared
      memory backing. Do not "optimise" this into static hugepages — you lose
      the share. (Static hugepages would also permanently subtract 32 GB from
      the host, which is worse than the marginal TLB win.)
    * <audio type='pipewire'> needs QEMU to run as the desktop user so it can
      reach /run/user/@UID@/pipewire-0. The setup script sets user/group in
      /etc/libvirt/qemu.conf accordingly.
    * hyperv <evmcs> is Intel-only and errors on AMD — deliberately absent.
    * The qxl head exists only for install and recovery. Daily use is RDP.
-->
<domain type='kvm'>
  <name>@NAME@</name>
  <uuid>@UUID@</uuid>
  <title>Windows 11 — devbox primary desktop</title>
  <metadata>
    <libosinfo:libosinfo xmlns:libosinfo="http://libosinfo.org/xmlns/libvirt/domain/1.0">
      <libosinfo:os id="http://microsoft.com/win/11"/>
    </libosinfo:libosinfo>
  </metadata>

  <memory unit='KiB'>@MEM_KIB@</memory>
  <currentMemory unit='KiB'>@MEM_KIB@</currentMemory>
  <memoryBacking>
    <source type='memfd'/>
    <access mode='shared'/>
  </memoryBacking>

  <vcpu placement='static'>@VCPUS@</vcpu>
  <iothreads>2</iothreads>
@CPUTUNE@

  <os firmware='efi'>
    <type arch='x86_64' machine='q35'>hvm</type>
    <firmware>
      <!-- Arch's OVMF package on this host provides no Microsoft-keyed
           variable store. Keep TPM 2.0, but disable Secure Boot rather than
           presenting Setup with an unusable empty key database. -->
      <feature enabled='no' name='enrolled-keys'/>
      <feature enabled='no' name='secure-boot'/>
    </firmware>
    <loader secure='no'/>
    <!-- The installation DVD is first while the guest disk is empty. -->
    <bootmenu enable='no'/>
  </os>

  <features>
    <acpi/>
    <apic/>
    <!-- Hyper-V enlightenments: large, measurable win for Windows guests.
         Without these the guest burns CPU on spinlocks and timer emulation. -->
    <hyperv mode='custom'>
      <relaxed state='on'/>
      <vapic state='on'/>
      <spinlocks state='on' retries='8191'/>
      <vpindex state='on'/>
      <runtime state='on'/>
      <synic state='on'/>
      <stimer state='on'><direct state='on'/></stimer>
      <frequencies state='on'/>
      <reenlightenment state='on'/>
      <tlbflush state='on'/>
      <ipi state='on'/>
    </hyperv>
    <vmport state='off'/>
    <!-- SMM is retained for OVMF/Windows compatibility. -->
    <smm state='on'/>
  </features>

  <cpu mode='host-passthrough' check='none' migratable='off'>
    <topology sockets='1' dies='1' cores='@CORES@' threads='@THREADS@'/>
    <!-- topoext is what makes AMD SMT topology visible to Windows. Without it
         Windows sees @VCPUS@ sockets and schedules terribly. -->
    <feature policy='require' name='topoext'/>
    <cache mode='passthrough'/>
  </cpu>

  <clock offset='localtime'>
    <timer name='rtc' tickpolicy='catchup'/>
    <timer name='pit' tickpolicy='delay'/>
    <timer name='hpet' present='no'/>
    <timer name='hypervclock' present='yes'/>
  </clock>

  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>

  <pm>
    <!-- A desktop you RDP into must never suspend itself. -->
    <suspend-to-mem enabled='no'/>
    <suspend-to-disk enabled='no'/>
  </pm>

  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>

    <!-- ===================== Storage ===================== -->
    <!-- A FAT32 virtual installer disk avoids the Windows DVD's unautomatable
         UEFI key gate.  SATA keeps its .swm payload readable by Windows PE. -->
    <disk type='file' device='disk'>
      <driver name='qemu' type='raw'/>
      <source file='@INSTALLER_USB_IMAGE@'/>
      <target dev='sda' bus='sata'/>
      <boot order='1'/>
    </disk>

    <disk type='file' device='disk'>
      <!-- SATA is deliberately used for the boot disk: Windows PE has the
           driver in-box, letting the unattended installer complete without a
           manual storage-driver screen. -->
      <driver name='qemu' type='raw' cache='none' io='native' discard='unmap'/>
      <source file='@DISK_PATH@'/>
      <target dev='sde' bus='sata'/>
      <boot order='2'/>
    </disk>

    <!-- Driver and answer media remain CDs; the Windows installer itself is
         the virtual USB disk above. -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='/var/lib/libvirt/images/iso/virtio-win.iso'/>
      <target dev='sdb' bus='sata'/>
      <readonly/>
    </disk>
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='/var/lib/libvirt/images/iso/windows-unattend.iso'/>
      <target dev='sdc' bus='sata'/>
      <readonly/>
    </disk>
    <!-- Setup is booted from the generated installer disk above, but its
         native ISO is kept attached as the source for install.wim.  Boot order
         ensures this CD never reaches the firmware's DVD key gate. -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='/var/lib/libvirt/images/iso/win11.iso'/>
      <target dev='sdd' bus='sata'/>
      <readonly/>
    </disk>

    <controller type='usb' index='0' model='qemu-xhci' ports='15'/>
    <controller type='sata' index='0'/>
    <controller type='pci' index='0' model='pcie-root'/>
    <controller type='pci' index='1' model='pcie-root-port'/>
    <controller type='pci' index='2' model='pcie-root-port'/>
    <controller type='pci' index='3' model='pcie-root-port'/>
    <controller type='pci' index='4' model='pcie-root-port'/>
    <controller type='pci' index='5' model='pcie-root-port'/>
    <controller type='pci' index='6' model='pcie-root-port'/>
    <controller type='virtio-serial' index='0'/>

    <!-- ===================== Shared drive ===================== -->
    <!-- Mounts as Z: in the guest via WinFsp + the VirtioFSSvc service that
         ships on virtio-win.iso. See README for the guest-side install and
         for why you must NOT put node_modules / build trees on this share. -->
    <filesystem type='mount' accessmode='passthrough'>
      <driver type='virtiofs' queue='1024'/>
      <binary path='/usr/lib/virtiofsd' xattr='on'>
        <cache mode='always'/>
        <sandbox mode='chroot'/>
      </binary>
      <source dir='@SHARE_DIR@'/>
      <target dir='winshare'/>
    </filesystem>

    <!-- ===================== Network ===================== -->
    <!-- NAT on libvirt's default network. The MAC is pinned so the setup
         script's DHCP reservation always hands out the same address and
         `winbox` never has to discover it. Tailscale runs INSIDE the guest
         for anything that needs to reach it from elsewhere. -->
    <interface type='network'>
      <mac address='@MAC@'/>
      <source network='default'/>
      <!-- e1000e has an in-box Windows driver, so networking works on the
           first desktop before the guest bootstrap can install VirtIO tools. -->
      <model type='e1000e'/>
    </interface>

    <!-- ===================== Audio ===================== -->
    <!-- FALLBACK path only. Emulated HDA over PipeWire: fine for system
         sounds and playback, ~20-40 ms and resampled on the way in.
         The REAL capture path is USB hostdev passthrough below — use that
         for anything where recording fidelity or latency is being tested. -->
    <sound model='ich9'>
      <audio id='1'/>
    </sound>
    <audio id='1' type='pipewire' runtimeDir='/run/user/@UID@'>
      <input name='win-vm-in'/>
      <output name='win-vm-out'/>
    </audio>

    <!-- ===================== USB passthrough ===================== -->
    <!-- Populated by scripts/setup-win-vm.sh from WIN_VM_USB in the module
         env file, and hot-pluggable at runtime with `win-usb attach <id>`.
         Typical members: a USB audio device, a monitor's USB hub, or the
         onboard Bluetooth radio (which lets the guest own BT headsets). -->
@HOSTDEV@

    <!-- ===================== Guest agent ===================== -->
    <channel type='unix'>
      <target type='virtio' name='org.qemu.guest_agent.0'/>
    </channel>

    <!-- ===================== Console head ===================== -->
    <!-- Install and recovery only. Daily driving is FreeRDP; see `winbox`. -->
    <video>
      <model type='qxl' ram='65536' vram='65536' vgamem='16384' heads='1' primary='yes'/>
    </video>
    <graphics type='vnc' autoport='yes' listen='127.0.0.1'>
      <listen type='address' address='127.0.0.1'/>
    </graphics>

    <input type='tablet' bus='usb'/>
    <!-- The Windows DVD boot wrapper reads the firmware USB keyboard path.
         Daily input arrives through FreeRDP once the guest is installed. -->
    <input type='keyboard' bus='usb'/>

    <!-- ===================== TPM ===================== -->
    <tpm model='tpm-crb'>
      <backend type='emulator' version='2.0'/>
    </tpm>

    <rng model='virtio'>
      <backend model='random'>/dev/urandom</backend>
    </rng>

    <!-- Ballooning off: deterministic memory, and it interacts badly with
         shared memfd backing. The guest gets its 32 GB and keeps it. -->
    <memballoon model='none'/>
  </devices>

</domain>
